APP_NAME=ExplodeX Backend
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

SCANNER_MIN_QUOTE_VOLUME_USDT=10000000
SCANNER_MAX_SYMBOLS=80
SCANNER_MIN_SETUP_SCORE=80
SCANNER_MAX_RISK_SCORE=35
SCANNER_DEEP_LIMIT=20

PAPER_TRADING_ONLY=true

SCHEDULER_ENABLED=true
SCANNER_INTERVAL_SECONDS=300
PAPER_MANAGE_INTERVAL_SECONDS=60
PAPER_SYNC_INTERVAL_SECONDS=300

NEWS_ENABLED=true
NEWS_MAX_CANDIDATES=8
NEWS_MAX_HEADLINES=10
NEWS_CACHE_TTL_SECONDS=900
